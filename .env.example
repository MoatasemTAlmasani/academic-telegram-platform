# Application
APP_NAME=academic-services-platform-api
APP_ENV=development
DEBUG=false

# Signing key for application JWTs.
SECRET_KEY=

# PostgreSQL connection URL.
DATABASE_URL=

# Telegram delivery mode: webhook (default for Vercel) or polling (dedicated worker only).
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMTP email verification and password recovery (optional until a verified sender is configured).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USE_SSL=false
PUBLIC_APP_URL=https://ehteraf-tech.vercel.app
