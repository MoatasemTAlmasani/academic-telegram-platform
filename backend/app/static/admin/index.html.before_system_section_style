<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Platform — Admin</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Inter, Arial, sans-serif;
            background: #07111f;
            color: #e8f1fb;
        }

        button, input, select {
            font: inherit;
        }

        .hidden {
            display: none !important;
        }

        .login-screen {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at top, #102b45 0%, #07111f 45%, #040a12 100%);
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #0c1a2b;
            border: 1px solid #183650;
            border-radius: 18px;
            padding: 36px;
            box-shadow: 0 25px 70px rgba(0,0,0,.45);
        }

        .brand-mark {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #00c8ff;
            color: #03111d;
            border-radius: 14px;
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .login-card h1 {
            margin: 0 0 8px;
            font-size: 28px;
        }

        .muted {
            color: #91a8bd;
        }

        label {
            display: block;
            margin: 20px 0 8px;
            color: #b8cadb;
            font-size: 14px;
        }

        input, select {
            width: 100%;
            background: #081522;
            border: 1px solid #1d3a53;
            color: #e8f1fb;
            padding: 12px 14px;
            border-radius: 10px;
            outline: none;
        }

        input:focus, select:focus {
            border-color: #00c8ff;
            box-shadow: 0 0 0 3px rgba(0,200,255,.1);
        }

        .primary-btn {
            width: 100%;
            border: 0;
            border-radius: 10px;
            padding: 13px;
            margin-top: 22px;
            background: #00c8ff;
            color: #03111d;
            font-weight: 700;
            cursor: pointer;
        }

        .primary-btn:hover {
            background: #33d5ff;
        }

        .error {
            margin-top: 14px;
            padding: 10px 12px;
            border-radius: 8px;
            background: #35151b;
            color: #ff9da9;
            border: 1px solid #71303a;
        }

        .app {
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #091625;
            border-right: 1px solid #173047;
            padding: 24px 16px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 10px 28px;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #00c8ff;
            color: #03111d;
            font-weight: 800;
        }

        .sidebar-title {
            font-weight: 750;
        }

        .sidebar-subtitle {
            color: #6f899e;
            font-size: 12px;
            margin-top: 2px;
        }

        .nav-section {
            color: #5f7890;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: .08em;
            padding: 15px 12px 8px;
        }

        .nav-btn {
            width: 100%;
            text-align: left;
            border: 0;
            background: transparent;
            color: #9db2c5;
            padding: 12px;
            border-radius: 9px;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .nav-btn:hover,
        .nav-btn.active {
            background: #10283d;
            color: #00c8ff;
        }

        .logout {
            position: absolute;
            left: 16px;
            right: 16px;
            bottom: 20px;
        }

        .main {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        .topbar {
            height: 72px;
            border-bottom: 1px solid #173047;
            background: #081522;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .topbar-title {
            font-size: 20px;
            font-weight: 700;
        }

        .user-badge {
            color: #91a8bd;
            font-size: 14px;
        }

        .content {
            padding: 30px;
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
        }

        .page-header h2 {
            margin: 0 0 6px;
            font-size: 26px;
        }

        .page-header p {
            margin: 0;
            color: #7891a6;
        }

        .action-btn {
            border: 1px solid #00c8ff;
            background: #00c8ff;
            color: #03111d;
            padding: 10px 16px;
            border-radius: 9px;
            font-weight: 700;
            cursor: pointer;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .card {
            background: #0c1a2b;
            border: 1px solid #173047;
            border-radius: 14px;
            padding: 20px;
        }

        .stat-label {
            color: #7891a6;
            font-size: 13px;
        }

        .stat-value {
            font-size: 29px;
            font-weight: 800;
            margin-top: 10px;
        }

        .panel {
            background: #0c1a2b;
            border: 1px solid #173047;
            border-radius: 14px;
            overflow: hidden;
        }

        .panel-header {
            padding: 18px 20px;
            border-bottom: 1px solid #173047;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-header h3 {
            margin: 0;
        }

        .filters {
            display: grid;
            grid-template-columns: 1fr 180px;
            gap: 12px;
            margin-bottom: 18px;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 15px 18px;
            border-bottom: 1px solid #142c40;
            white-space: nowrap;
        }

        th {
            color: #7891a6;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        td {
            color: #d7e4ef;
            font-size: 14px;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 12px;
        }

        .status.active {
            background: #103526;
            color: #5fe0a3;
        }

        .status.inactive {
            background: #38271a;
            color: #e9b76a;
        }

        .table-action {
            background: transparent;
            border: 1px solid #29445a;
            color: #9db2c5;
            padding: 6px 10px;
            border-radius: 7px;
            cursor: pointer;
            margin-right: 5px;
        }

        .table-action:hover {
            border-color: #00c8ff;
            color: #00c8ff;
        }

        .empty {
            text-align: center;
            color: #71899d;
            padding: 35px;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.7);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 100;
        }

        .modal {
            width: 100%;
            max-width: 520px;
            background: #0c1a2b;
            border: 1px solid #23435c;
            border-radius: 16px;
            padding: 25px;
        }

        .modal h3 {
            margin-top: 0;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .secondary-btn {
            border: 1px solid #29445a;
            background: transparent;
            color: #a9bbca;
            padding: 10px 16px;
            border-radius: 9px;
            cursor: pointer;
        }

        .loading {
            color: #00c8ff;
            padding: 25px;
            text-align: center;
        }

        @media (max-width: 1000px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 700px) {
            .sidebar {
                width: 70px;
                padding: 15px 8px;
            }

            .sidebar-title,
            .sidebar-subtitle,
            .nav-section {
                display: none;
            }

            .sidebar-brand {
                justify-content: center;
                padding-bottom: 20px;
            }

            .nav-btn {
                text-align: center;
                font-size: 0;
            }

            .nav-btn::first-letter {
                font-size: 18px;
            }

            .main {
                margin-left: 70px;
                width: calc(100% - 70px);
            }

            .content {
                padding: 18px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .filters {
                grid-template-columns: 1fr;
            }
        }
    </style>

<style id="user-modal-fix">
#userModal {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    z-index: 999999 !important;
    background: rgba(0, 0, 0, 0.75) !important;
    padding: 24px !important;
    box-sizing: border-box !important;
}

#userModal .modal-backdrop {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    z-index: 0 !important;
}

#userModal .modal-dialog {
    position: relative !important;
    z-index: 1 !important;
    width: min(760px, calc(100vw - 48px)) !important;
    max-height: calc(100vh - 48px) !important;
    overflow-y: auto !important;
    margin: auto !important;
    background: #ffffff !important;
    border-radius: 14px !important;
    box-sizing: border-box !important;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35) !important;
}

#userModal .modal-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 20px !important;
    padding: 24px !important;
}

#userModal form {
    padding: 0 24px 24px 24px !important;
}

#userModal .form-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 16px !important;
}

#userModal .form-group {
    min-width: 0 !important;
}

#userModal input,
#userModal select {
    width: 100% !important;
    box-sizing: border-box !important;
}

#userModal .modal-actions {
    display: flex !important;
    justify-content: flex-end !important;
    gap: 10px !important;
    margin-top: 24px !important;
}

#userModal .modal-close {
    cursor: pointer !important;
    border: 0 !important;
    background: transparent !important;
    font-size: 28px !important;
    line-height: 1 !important;
}

@media (max-width: 700px) {
    #userModal .form-grid {
        grid-template-columns: 1fr !important;
    }

    #userModal .modal-dialog {
        width: calc(100vw - 24px) !important;
        max-height: calc(100vh - 24px) !important;
    }
}
</style>


<style id="access-control-settings-css">

.access-layout {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr)
                         minmax(260px, 1.1fr)
                         minmax(320px, 1.5fr);
    gap: 20px;
    align-items: start;
}

.access-list {
    max-height: 520px;
    overflow-y: auto;
}

.access-item {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    border-bottom: 1px solid #e5e7eb;
    background: transparent;
    padding: 14px;
    cursor: pointer;
}

.access-item:hover {
    background: #f8fafc;
}

.access-item.active {
    background: #eef6ff;
}

.access-item strong {
    display: block;
    margin-bottom: 4px;
}

.access-item .muted {
    font-size: 12px;
}

.permission-checklist {
    max-height: 520px;
    overflow-y: auto;
    padding: 8px 0;
}

.permission-check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 11px 14px;
    border-bottom: 1px solid #eef0f3;
}

.permission-check input {
    margin-top: 3px;
}

.permission-code {
    font-family: monospace;
    font-size: 13px;
}

.permission-description {
    font-size: 12px;
    color: #6b7280;
    margin-top: 3px;
}

.status-grid {
    display: grid;
    gap: 0;
}

.status-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid #eef0f3;
}

.status-row:last-child {
    border-bottom: 0;
}

.success {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #ecfdf5;
    color: #047857;
}

@media (max-width: 1100px) {
    .access-layout {
        grid-template-columns: 1fr;
    }

    .access-list,
    .permission-checklist {
        max-height: 360px;
    }
}

</style>


<style id="staff-management-css">
#staffModal {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    z-index: 999999 !important;
    background: rgba(0, 0, 0, 0.75) !important;
    padding: 24px !important;
    box-sizing: border-box !important;
}

#staffModal .modal-content {
    width: min(900px, 100%) !important;
    max-height: 90vh !important;
    overflow-y: auto !important;
}

#staffModal .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

@media (max-width: 700px) {
    #staffModal .form-grid {
        grid-template-columns: 1fr;
    }
}
</style>

</head>

<body>

<div id="loginScreen" class="login-screen">
    <div class="login-card">
        <div class="brand-mark">A</div>
        <h1>Academic Platform</h1>
        <p class="muted">Administrator Control Center</p>

        <form id="loginForm">
            <label for="username">Username</label>
            <input id="username" type="text" autocomplete="username" required>

            <label for="password">Password</label>
            <input id="password" type="password" autocomplete="current-password" required>

            <button id="loginButton" class="primary-btn" type="submit">
                Sign In
            </button>

            <div id="loginError" class="error hidden"></div>
        </form>
    </div>
</div>

<div id="appView" class="app hidden">

    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-logo">A</div>
            <div>
                <div class="sidebar-title">Academic Platform</div>
                <div class="sidebar-subtitle">Admin Center</div>
            </div>
        </div>

        <div class="nav-section">Management</div>

        <button class="nav-btn active" data-page="dashboard">
            ◉ &nbsp; Dashboard
        </button>

        <button class="nav-btn" data-page="users">
            ◎ &nbsp; Users
        </button>

        <button class="nav-btn" data-page="services">
            ◈ &nbsp; Services
        </button>

        <button class="nav-btn" data-page="staff">
            ♟ &nbsp; Staff
        </button>

        <div class="nav-section">System</div>

        <button class="nav-btn" data-page="access-control">
            🔐 &nbsp; Access Control
        </button>

                <button class="nav-btn" data-page="settings">
            ⚙ &nbsp; Settings
        </button>

        <button id="logoutButton" class="nav-btn logout">
            ⇥ &nbsp; Logout
        </button>
    </aside>

    <main class="main">

        <header class="topbar">
            <div id="topbarTitle" class="topbar-title">Dashboard</div>
            <div id="currentUser" class="user-badge"></div>
        </header>

        <section class="content">

            <div id="page-dashboard" class="page active">
                <div class="page-header">
                    <div>
                        <h2>Dashboard Overview</h2>
                        <p>Academic Services Platform administration</p>
                    </div>
                </div>

                <div class="cards">
                    <div class="card">
                        <div class="stat-label">Users</div>
                        <div id="statUsers" class="stat-value">—</div>
                    </div>

                    <div class="card">
                        <div class="stat-label">Services</div>
                        <div id="statServices" class="stat-value">—</div>
                    </div>

                    <div class="card">
                        <div class="stat-label">Active Services</div>
                        <div id="statActiveServices" class="stat-value">—</div>
                    </div>

                    <div class="card">
                        <div class="stat-label">System</div>
                        <div class="stat-value">OK</div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h3>System Status</h3>
                    </div>
                    <div class="empty">
                        Authentication and API services are operational.
                    </div>
                </div>
            </div>

            <div id="page-users" class="page">
                <div class="page-header">
                    <div>
                        <h2>Users</h2>
                        <p>Manage platform users and staff accounts</p>
                    </div>

                    <button id="addUserBtn" class="action-btn" type="button" onclick="openUserModal(null)">
                        + Add User
                    </button>
                </div>

                <div class="panel">
                    <div id="usersContent" class="loading">Loading users...</div>
                </div>
            </div>

            <div id="page-services" class="page">

                <div class="page-header">
                    <div>
                        <h2>Services</h2>
                        <p>Manage academic services offered by the platform</p>
                    </div>

                    <button id="addServiceButton" class="action-btn">
                        + Add Service
                    </button>
                </div>

                <div class="filters">
                    <input id="serviceSearch"
                           type="search"
                           placeholder="Search services...">

                    <select id="serviceStatus">
                        <option value="">All statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                <div class="panel">
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Sort</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="servicesTable">
                                <tr>
                                    <td colspan="6" class="loading">
                                        Loading services...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>


            
<div id="page-staff" class="page">
    <div class="page-header">
        <div>
            <h2>Staff</h2>
            <p>Manage staff members and their academic roles.</p>
        </div>

        <button id="addStaffButton" class="action-btn" type="button">
            + Add Staff
        </button>
    </div>

    <div class="filters">
        <input
            id="staffSearch"
            type="search"
            placeholder="Search staff..."
        >

        <select id="staffStatus">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>

    <div class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Specialization</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="staffTable">
                    <tr>
                        <td colspan="5">
                            <div class="loading">
                                Loading staff...
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="staffModal" class="modal">
    <div class="modal-content">

        <div class="modal-header">
            <div>
                <h3 id="staffModalTitle">Add Staff</h3>
                <p>Staff account and profile information</p>
            </div>

            <button
                id="cancelStaff"
                class="icon-btn"
                type="button"
            >
                ×
            </button>
        </div>

        <form id="staffForm">

            <input id="staffId" type="hidden">

            <div class="form-grid">

                <div class="form-group">
                    <label for="staffUsername">Username</label>
                    <input
                        id="staffUsername"
                        type="text"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="staffPassword">Password</label>
                    <input
                        id="staffPassword"
                        type="password"
                    >
                </div>

                <div class="form-group">
                    <label for="staffFirstName">First Name</label>
                    <input id="staffFirstName" type="text">
                </div>

                <div class="form-group">
                    <label for="staffLastName">Last Name</label>
                    <input id="staffLastName" type="text">
                </div>

                <div class="form-group">
                    <label for="staffEmail">Email</label>
                    <input id="staffEmail" type="email">
                </div>

                <div class="form-group">
                    <label for="staffPhone">Phone</label>
                    <input id="staffPhone" type="text">
                </div>

                <div class="form-group">
                    <label for="staffSpecialization">
                        Specialization
                    </label>
                    <input
                        id="staffSpecialization"
                        type="text"
                        placeholder="e.g. Network Engineering"
                    >
                </div>

                <div class="form-group">
                    <label for="staffAvailability">
                        Availability
                    </label>
                    <input
                        id="staffAvailability"
                        type="text"
                        placeholder="e.g. 09:00 - 17:00"
                    >
                </div>

                <div class="form-group">
                    <label for="staffStatusInput">Status</label>
                    <select id="staffStatusInput">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="staffActive">Profile Active</label>
                    <select id="staffActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

            </div>

            <div id="staffError" class="error hidden"></div>

            <div class="modal-actions">

                <button
                    id="cancelStaffButton"
                    class="secondary-btn"
                    type="button"
                >
                    Cancel
                </button>

                <button
                    id="saveStaffButton"
                    class="primary-btn"
                    type="submit"
                >
                    Save Staff
                </button>

            </div>

        </form>

    </div>
</div>

<div id="page-access-control" class="page">
