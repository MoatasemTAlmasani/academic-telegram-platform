    function initialize() {

        // Login events must always be bound, even when no token exists.
        bindEvents();

        if (!token) {
            console.warn("No admin token found. Login screen remains active.");
            return;
        }

        apiFetch(API + "/auth/me")
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Authentication failed.");
                }

                return response.json();
            })
            .then(function (user) {

                if ($("currentUser")) {
                    $("currentUser").textContent =
                        user.username ||
                        user.email ||
                        "Admin";
                }

                showPage("dashboard");
            })
            .catch(function (error) {
                console.error(error);
                logout();
            });
    }

    /*
     * The script is placed before the closing body tag,
     * but initialize after the DOM is ready.
     */
    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                bindEvents();
                initialize();
            }
        );
    } else {
        bindEvents();
        initialize();
    }





