<script>

(function () {
    "use strict";

    var API = "/api/v1";
    var token = localStorage.getItem("admin_access_token");

    function $(id) {
        return document.getElementById(id);
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function formatDate(value) {
        if (!value) {
            return "—";
        }

        try {
            return new Date(value).toLocaleString();
        } catch (e) {
            return value;
        }
    }

    async function apiFetch(url, options) {
        options = options || {};
        options.headers = options.headers || {};

        if (token) {
            options.headers["Authorization"] = "Bearer " + token;
        }

        var response = await fetch(url, options);

        if (response.status === 401) {
            logout();
        }

        return response;
    }


    async function login(event) {
        event.preventDefault();

        var usernameEl = $("username");
        var passwordEl = $("password");
        var errorEl = $("loginError");
        var loginButton = $("loginButton");

        if (errorEl) {
            errorEl.textContent = "";
            errorEl.style.display = "none";
        }

        var username = usernameEl ? usernameEl.value.trim() : "";
        var password = passwordEl ? passwordEl.value : "";

        if (!username || !password) {
            if (errorEl) {
                errorEl.textContent = "Please enter username and password.";
                errorEl.style.display = "block";
            }
            return;
        }

        if (loginButton) {
            loginButton.disabled = true;
            loginButton.textContent = "Signing in...";
        }

        try {
            var response = await fetch(API + "/auth/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    username: username,
                    password: password
                })
            });

            var data = await response.json();

            if (!response.ok) {
                var message = "Login failed.";

                if (data && data.error && data.error.message) {
                    message = data.error.message;
                } else if (data && data.detail) {
                    message = data.detail;
                }

                throw new Error(message);
            }

            var accessToken = null;

            if (data && data.access_token) {
                accessToken = data.access_token;
            } else if (data && data.data && data.data.access_token) {
                accessToken = data.data.access_token;
            }

            if (!accessToken) {
                throw new Error("Login succeeded but no access token was returned.");
            }

            localStorage.setItem("admin_access_token", accessToken);

            if (data && data.user) {
                localStorage.setItem(
                    "admin_user",
                    JSON.stringify(data.user)
                );
            } else if (data && data.data && data.data.user) {
                localStorage.setItem(
                    "admin_user",
                    JSON.stringify(data.data.user)
                );
            }

            // Activate the application immediately after successful login.
            token = accessToken;

            var loginView = $("loginScreen");
            var appView = $("appView");

            if (loginView) {
                loginView.classList.add("hidden");
            }

            if (appView) {
                appView.classList.remove("hidden");
            }

            bindEvents();

            apiFetch(API + "/auth/me")
                .then(function (meResponse) {
                    if (!meResponse.ok) {
                        throw new Error("Authentication failed after login.");
                    }

                    return meResponse.json();
                })
                .then(function (user) {
                    if ($("currentUser")) {
                        $("currentUser").textContent =
                            user.username ||
                            user.email ||
                            "Admin";
                    }

                    showPage("dashboard");
                })
                .catch(function (error) {
                    console.error(error);

                    if (errorEl) {
                        errorEl.textContent =
                            error.message ||
                            "Login succeeded but dashboard initialization failed.";
                        errorEl.style.display = "block";
                    }
                })
                .finally(function () {
                    if (loginButton) {
                        loginButton.disabled = false;
                        loginButton.textContent = "Sign In";
                    }
                });

        } catch (error) {
            if (errorEl) {
                errorEl.textContent = error.message || "Login failed.";
                errorEl.style.display = "block";
            }

            if (loginButton) {
                loginButton.disabled = false;
                loginButton.textContent = "Login";
            }
        }
    }

    function logout() {
        localStorage.removeItem("admin_access_token");
        localStorage.removeItem("admin_user");
        window.location.reload();
    }

    function showPage(pageName) {
        var pages = document.querySelectorAll(".page");

        pages.forEach(function (page) {
            page.classList.remove("active");
        });

        var navButtons = document.querySelectorAll(
            ".nav-btn[data-page]"
        );

        navButtons.forEach(function (button) {
            button.classList.remove("active");
        });

        var target = $("page-" + pageName);

        if (target) {
            target.classList.add("active");
        }

        navButtons.forEach(function (button) {
            if (button.getAttribute("data-page") === pageName) {
                button.classList.add("active");
            }
        });

        var title = $("topbarTitle");

        if (title) {
            var titles = {
                dashboard: "Dashboard",
                users: "Users",
                services: "Services",
                staff: "Staff",
                settings: "Settings"
            };

            title.textContent = titles[pageName] || "Dashboard";
        }

        if (pageName === "dashboard") {
            loadDashboard();
        }

        if (pageName === "users") {
            loadUsers();
        }

        if (pageName === "services") {
            loadServices();
        }

        if (pageName === "staff") {
            loadStaff();
        }

        if (pageName === "access-control") {
            loadAccessControl();
        }

        if (pageName === "settings") {
            loadSettings();
        }
    }

    function closeUserModal() {
        var modal = $("userModal");

        if (modal) {
            modal.style.display = "none";
        }
    }

    window.closeUserModal = closeUserModal;

    function openUserModal(user) {
        var modal = $("userModal");

        if (!modal) {
            alert("User modal was not found.");
            return;
        }

        $("userModalTitle").textContent =
            user ? "Edit User" : "Add User";

        $("userModalSubtitle").textContent =
            user
                ? "Update platform user information."
                : "Create a new platform user.";

        $("userId").value = user && user.id ? user.id : "";
        $("userUsername").value =
            user && user.username ? user.username : "";

        $("userPassword").value = "";

        $("userEmail").value =
            user && user.email ? user.email : "";

        $("userPhone").value =
            user && user.phone ? user.phone : "";

        $("userFirstName").value =
            user && user.first_name ? user.first_name : "";

        $("userLastName").value =
            user && user.last_name ? user.last_name : "";

        $("userLanguage").value =
            user && user.language ? user.language : "";

        $("userTimezone").value =
            user && user.timezone ? user.timezone : "";

        var role = "customer";

        if (
            user &&
            user.roles &&
            user.roles.length &&
            user.roles[0] &&
            user.roles[0].name
        ) {
            role = user.roles[0].name;
        }

        $("userRole").value = role;

        $("userStatus").value =
            user && user.status ? user.status : "active";

        $("userPassword").required = !user;

        $("passwordRequired").textContent = user ? "" : "*";

        $("userFormError").style.display = "none";
        $("userFormError").textContent = "";

        modal.style.display = "flex";
    }

    window.openUserModal = openUserModal;
    window.closeUserModal = closeUserModal;
    window.saveUser = saveUser;
    window.editUserById = editUserById;
    window.openServiceModal = openServiceModal;
    window.closeServiceModal = closeServiceModal;
    window.editServiceById = editServiceById;


    async function saveUser(event) {
        event.preventDefault();

        var userId = $("userId").value;
        var button = $("saveUserBtn");
        var error = $("userFormError");

        var payload = {
            username: $("userUsername").value.trim(),
            email: $("userEmail").value.trim() || null,
            first_name: $("userFirstName").value.trim() || null,
            last_name: $("userLastName").value.trim() || null,
            phone: $("userPhone").value.trim() || null,
            language: $("userLanguage").value.trim() || null,
            timezone: $("userTimezone").value.trim() || null,
            status: $("userStatus").value,
            role: $("userRole").value
        };

        var password = $("userPassword").value;

        if (!userId) {
            payload.password = password;
        } else if (password) {
            payload.password = password;
        }

        try {
            button.disabled = true;
            button.textContent = userId ? "Updating..." : "Creating...";
            error.style.display = "none";

            var url = userId
                ? API + "/admin/users/" + userId
                : API + "/admin/users";

            var response = await apiFetch(url, {
                method: userId ? "PATCH" : "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            var data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail ||
                    data.message ||
                    "Unable to save user."
                );
            }

            closeUserModal();
            await loadUsers();
            await loadDashboard();

        } catch (err) {
            error.textContent = err.message;
            error.style.display = "block";

        } finally {
            button.disabled = false;
            button.textContent = "Save User";
        }
    }

    async function editUserById(userId) {
        try {
            var response = await apiFetch(
                API + "/admin/users/" + userId
            );

            var user = await response.json();

            if (!response.ok) {
                throw new Error(
                    user.detail || "Unable to load user."
                );
            }

            openUserModal(user);

        } catch (err) {
            alert(err.message);
        }
    }

    async function loadUsers() {
        var container = $("usersContent");

        if (!container) {
            return;
        }

        container.innerHTML =
            '<div class="loading">Loading users...</div>';

        try {
            var response = await apiFetch(
                API + "/admin/users?page=1&page_size=100"
            );

            var data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail || "Unable to load users."
                );
            }

            var users = Array.isArray(data.items)
                ? data.items
                : [];

            if (!users.length) {
                container.innerHTML =
                    '<div class="empty">No users found.</div>';
                return;
            }

            var rows = users.map(function (user) {
                var roleNames = "—";

                if (user.roles && user.roles.length) {
                    roleNames = user.roles
                        .map(function (role) {
                            return role.name;
                        })
                        .join(", ");
                }

                var fullName = [
                    user.first_name,
                    user.last_name
                ]
                    .filter(function (x) {
                        return Boolean(x);
                    })
                    .join(" ");

                if (!fullName) {
                    fullName = "—";
                }

                return (
                    "<tr>" +
                    "<td>" +
                    "<strong>" +
                    escapeHtml(user.username || "—") +
                    "</strong>" +
                    '<div class="muted">' +
                    escapeHtml(fullName) +
                    "</div>" +
                    "</td>" +
                    "<td>" +
                    escapeHtml(user.email || "—") +
                    "</td>" +
                    "<td>" +
                    escapeHtml(roleNames) +
                    "</td>" +
                    "<td>" +
                    '<span class="status-badge">' +
                    escapeHtml(user.status || "—") +
                    "</span>" +
                    "</td>" +
                    "<td>" +
                    formatDate(user.created_at) +
                    "</td>" +
                    "<td>" +
                    '<button type="button" ' +
                    'class="btn btn-small btn-secondary edit-user-button" ' +
                    'data-user-id="' +
                    escapeHtml(user.id) +
                    '">' +
                    "Edit" +
                    "</button>" +
                    "</td>" +
                    "</tr>"
                );
            }).join("");

            container.innerHTML =
                '<div class="table-wrap">' +
                '<table class="data-table">' +
                "<thead>" +
                "<tr>" +
                "<th>User</th>" +
                "<th>Email</th>" +
                "<th>Role</th>" +
                "<th>Status</th>" +
                "<th>Created</th>" +
                "<th>Actions</th>" +
                "</tr>" +
                "</thead>" +
                "<tbody>" +
                rows +
                "</tbody>" +
                "</table>" +
                "</div>";

            var editButtons = document.querySelectorAll(
                ".edit-user-button"
            );

            editButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    editUserById(
                        button.getAttribute("data-user-id")
                    );
                });
            });

        } catch (error) {
            container.innerHTML =
                '<div class="empty">' +
                "Unable to load users: " +
                escapeHtml(error.message) +
                "</div>";
        }
    }

    async function loadServices() {
        var container = $("servicesTable");

        if (!container) {
            console.error("servicesTable element not found.");
            return;
        }

        container.innerHTML =
            '<tr><td colspan="6" class="loading">Loading services...</td></tr>';

        try {
            var response = await apiFetch(
                API + "/admin/services?page=1&page_size=100"
            );

            var data = await response.json();

            if (!response.ok) {
                var message =
                    data.detail ||
                    data.message ||
                    (data.error && data.error.message) ||
                    "Unable to load services.";

                throw new Error(message);
            }

            var services = Array.isArray(data.items)
                ? data.items
                : [];

            var searchEl = $("serviceSearch");
            var statusEl = $("serviceStatus");

            var search =
                searchEl ? searchEl.value.trim().toLowerCase() : "";

            var status =
                statusEl ? statusEl.value : "";

            services = services.filter(function (service) {
                var matchesSearch = true;
                var matchesStatus = true;

                if (search) {
                    var text = [
                        service.name,
                        service.description,
                        service.short_description,
                        service.category_name
                    ]
                        .filter(function (x) {
                            return Boolean(x);
                        })
                        .join(" ")
                        .toLowerCase();

                    matchesSearch = text.indexOf(search) !== -1;
                }

                if (status !== "") {
                    matchesStatus =
                        String(service.is_active) === status;
                }

                return matchesSearch && matchesStatus;
            });

            if (!services.length) {
                container.innerHTML =
                    '<tr>' +
                    '<td colspan="6" class="empty">' +
                    "No services found." +
                    "</td>" +
                    "</tr>";

                return;
            }

            container.innerHTML = services.map(function (service) {

                var categoryName = "—";

                if (service.category && service.category.name) {
                    categoryName = service.category.name;
                } else if (service.category_name) {
                    categoryName = service.category_name;
                }

                var statusText =
                    service.is_active ? "Active" : "Inactive";

                var statusClass =
                    service.is_active
                        ? "status-badge"
                        : "status-badge inactive";

                return (
                    "<tr>" +

                    "<td>" +
                    "<strong>" +
                    escapeHtml(service.name || "—") +
                    "</strong>" +
                    "</td>" +

                    "<td>" +
                    escapeHtml(categoryName) +
                    "</td>" +

                    "<td>" +
                    escapeHtml(
                        service.short_description ||
                        service.description ||
                        "—"
                    ) +
                    "</td>" +

                    "<td>" +
                    '<span class="' +
                    statusClass +
                    '">' +
                    escapeHtml(statusText) +
                    "</span>" +
                    "</td>" +

                    "<td>" +
                    escapeHtml(
                        service.sort_order !== undefined
                            ? service.sort_order
                            : "0"
                    ) +
                    "</td>" +

                    "<td>" +
                    '<button type="button" ' +
                    'class="btn btn-small btn-secondary edit-service-button" ' +
                    'data-service-id="' +
                    escapeHtml(service.id) +
                    '">' +
                    "Edit" +
                    "</button>" +
                    "</td>" +

                    "</tr>"
                );
            }).join("");

            var editButtons = document.querySelectorAll(
                ".edit-service-button"
            );

            editButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    editServiceById(
                        button.getAttribute("data-service-id")
                    );
                });
            });

        } catch (error) {
            console.error("loadServices error:", error);

            container.innerHTML =
                '<tr>' +
                '<td colspan="6" class="empty">' +
                "Unable to load services: " +
                escapeHtml(error.message) +
                "</td>" +
                "</tr>";
        }
    }

    async function editServiceById(serviceId) {
        try {
            var response = await apiFetch(
                API + "/admin/services/" + serviceId
            );

            var service = await response.json();

            if (!response.ok) {
                throw new Error(
                    service.detail ||
                    service.message ||
                    "Unable to load service."
                );
            }

            openServiceModal(service);

        } catch (error) {
            alert(error.message);
        }
    }

    async function loadServiceCategories() {
        var categorySelect = $("serviceCategory");

        if (!categorySelect) {
            return;
        }

        categorySelect.innerHTML =
            '<option value="">Loading categories...</option>';

        try {
            var response = await apiFetch(
                API + "/admin/services/categories"
            );

            var data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail ||
                    data.message ||
                    "Unable to load categories."
                );
            }

            var categories = Array.isArray(data.items)
                ? data.items
                : [];

            if (!categories.length) {
                categorySelect.innerHTML =
                    '<option value="">No categories available</option>';
                return;
            }

            categorySelect.innerHTML =
                '<option value="">Select category</option>' +
                categories.map(function (category) {
                    return (
                        '<option value="' +
                        escapeHtml(category.id) +
                        '">' +
                        escapeHtml(category.name) +
                        "</option>"
                    );
                }).join("");

        } catch (error) {
            console.error("loadServiceCategories error:", error);

            categorySelect.innerHTML =
                '<option value="">Unable to load categories</option>';
        }
    }

    function openServiceModal(service) {
        var modal = $("serviceModal");

        if (!modal) {
            return;
        }

        $("modalTitle").textContent =
            service ? "Edit Service" : "Add Service";

        $("serviceId").value =
            service && service.id ? service.id : "";

        $("serviceName").value =
            service && service.name ? service.name : "";

        $("serviceDescription").value =
            service && service.description
                ? service.description
                : "";

        $("serviceShortDescription").value =
            service && service.short_description
                ? service.short_description
                : "";

        $("serviceSortOrder").value =
            service && service.sort_order !== undefined
                ? service.sort_order
                : 0;

        var categoryId =
            service && service.category_id
                ? service.category_id
                : "";

        loadServiceCategories().then(function () {
            if ($("serviceCategory")) {
                $("serviceCategory").value = categoryId;
            }
        });

        if ($("serviceError")) {
            $("serviceError").textContent = "";
            $("serviceError").style.display = "none";
        }

        modal.classList.remove("hidden");
        modal.style.display = "flex";
    }

    function closeServiceModal() {
        var modal = $("serviceModal");

        if (modal) {
            modal.classList.add("hidden");
            modal.style.display = "none";
        }
    }

    async function saveService(event) {
        event.preventDefault();

        var serviceId = $("serviceId").value;
        var button = $("serviceForm").querySelector(
            'button[type="submit"]'
        );
        var error = $("serviceError");

        var payload = {
            category_id: $("serviceCategory").value,
            name: $("serviceName").value.trim(),
            description:
                $("serviceDescription").value.trim() || null,
            short_description:
                $("serviceShortDescription").value.trim() || null,
            sort_order:
                Number($("serviceSortOrder").value || 0)
        };

        if (!payload.category_id) {
            if (error) {
                error.textContent = "Please select a category.";
                error.style.display = "block";
            }
            return;
        }

        try {
            if (button) {
                button.disabled = true;
                button.textContent =
                    serviceId ? "Updating..." : "Creating...";
            }

            if (error) {
                error.textContent = "";
                error.style.display = "none";
            }

            var url = serviceId
                ? API + "/admin/services/" + serviceId
                : API + "/admin/services";

            var response = await apiFetch(url, {
                method: serviceId ? "PATCH" : "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            var data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail ||
                    data.message ||
                    "Unable to save service."
                );
            }

            closeServiceModal();

            await loadServices();
            await loadDashboard();

        } catch (errorValue) {
            console.error("saveService error:", errorValue);

            if (error) {
                error.textContent = errorValue.message;
                error.style.display = "block";
            }

        } finally {
            if (button) {
                button.disabled = false;
                button.textContent = "Save Service";
            }
        }
    }

    
