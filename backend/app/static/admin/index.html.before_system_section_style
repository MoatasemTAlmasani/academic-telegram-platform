var staffUsers = [];


function staffGet(id) {
    return document.getElementById(id);
}

function loadStaff() {
    var table = staffGet("staffTable");

    if (!table) {
        return;
    }

    table.innerHTML =
        '<tr><td colspan="5"><div class="loading">Loading staff...</div></td></tr>';

    var search = staffGet("staffSearch");
    var status = staffGet("staffStatus");

    var params = new URLSearchParams();

    params.set("page", "1");
    params.set("page_size", "100");

    if (search && search.value.trim()) {
        params.set("search", search.value.trim());
    }

    if (status && status.value) {
        params.set("status", status.value);
    }

    apiFetch(API + "/admin/staff?" + params.toString())
        .then(function(response) {
            if (!response.ok) {
                throw new Error("Failed to load staff.");
            }

            return response.json();
        })
        .then(function(data) {
            staffUsers = data.items || [];
            renderStaff();
        })
        .catch(function(error) {
            console.error(error);

            table.innerHTML =
                '<tr><td colspan="5">' +
                '<div class="error">Failed to load staff.</div>' +
                '</td></tr>';
        });
}

function renderStaff() {
    var table = staffGet("staffTable");

    if (!table) {
        return;
    }

    if (!staffUsers.length) {
        table.innerHTML =
            '<tr><td colspan="5">' +
            '<div class="empty">No staff members found.</div>' +
            '</td></tr>';

        return;
    }

    table.innerHTML = staffUsers.map(function(staff) {

        var name = [
            staff.first_name || "",
            staff.last_name || ""
        ].join(" ").trim();

        if (!name) {
            name = staff.username || "Unnamed";
        }

        var statusClass =
            String(staff.status).toLowerCase() === "active"
                ? "status-active"
                : "status-inactive";

        return (
            "<tr>" +
                "<td>" +
                    escapeHtml(name) +
                "</td>" +

                "<td>" +
                    escapeHtml(staff.username || "-") +
                "</td>" +

                "<td>" +
                    escapeHtml(
                        staff.specialization || "-"
                    ) +
                "</td>" +

                "<td>" +
                    '<span class="status ' +
                    statusClass +
                    '">' +
                        escapeHtml(
                            staff.status || "-"
                        ) +
                    "</span>" +
                "</td>" +

                "<td>" +
                    '<button class="action-btn small" ' +
                    'type="button" ' +
                    'data-staff-edit="' +
                    staff.id +
                    '">' +
                    "Edit" +
                    "</button>" +
                "</td>" +

            "</tr>"
        );

    }).join("");

    table.querySelectorAll(
        "[data-staff-edit]"
    ).forEach(function(button) {

        button.addEventListener(
            "click",
            function() {
                editStaffById(
                    button.getAttribute(
                        "data-staff-edit"
                    )
                );
            }
        );

    });
}

function openStaffModal(staff) {

    var modal = staffGet("staffModal");

    if (!modal) {
        return;
    }

    staffGet("staffId").value =
        staff && staff.id
            ? staff.id
            : "";

    staffGet("staffUsername").value =
        staff && staff.username
            ? staff.username
            : "";

    staffGet("staffPassword").value = "";

    staffGet("staffFirstName").value =
        staff && staff.first_name
            ? staff.first_name
            : "";

    staffGet("staffLastName").value =
        staff && staff.last_name
            ? staff.last_name
            : "";

    staffGet("staffEmail").value =
        staff && staff.email
            ? staff.email
            : "";

    staffGet("staffPhone").value =
        staff && staff.phone
            ? staff.phone
            : "";

    staffGet("staffSpecialization").value =
        staff && staff.specialization
            ? staff.specialization
            : "";

    staffGet("staffAvailability").value =
        staff && staff.availability
            ? staff.availability
            : "";

    staffGet("staffStatusInput").value =
        staff && staff.status
            ? String(staff.status).toLowerCase()
            : "active";

    staffGet("staffActive").value =
        staff &&
        typeof staff.is_active === "boolean"
            ? String(staff.is_active)
            : "true";

    staffGet("staffUsername").disabled =
        !!(staff && staff.id);

    staffGet("staffModalTitle").textContent =
        staff && staff.id
            ? "Edit Staff"
            : "Add Staff";

    staffGet("staffPassword").required =
        !(staff && staff.id);

    staffGet("staffError").classList.add("hidden");
    staffGet("staffError").textContent = "";

    modal.style.display = "flex";
}

function closeStaffModal() {

    var modal = staffGet("staffModal");

    if (modal) {
        modal.style.display = "none";
    }
}

function editStaffById(userId) {

    apiFetch(
        API +
        "/admin/staff/" +
        encodeURIComponent(userId)
    )
        .then(function(response) {

            if (!response.ok) {
                throw new Error(
                    "Failed to load staff member."
                );
            }

            return response.json();
        })
        .then(function(staff) {
            openStaffModal(staff);
        })
        .catch(function(error) {

            console.error(error);

            alert(
                "Failed to load staff member."
            );
        });
}

function saveStaff(event) {

    event.preventDefault();

    var id = staffGet("staffId").value;

    var payload = {
        email:
            staffGet("staffEmail").value.trim() ||
            null,

        first_name:
            staffGet("staffFirstName").value.trim() ||
            null,

        last_name:
            staffGet("staffLastName").value.trim() ||
            null,

        phone:
            staffGet("staffPhone").value.trim() ||
            null,

        specialization:
            staffGet("staffSpecialization").value.trim() ||
            null,

        availability:
            staffGet("staffAvailability").value.trim() ||
            null,

        status:
            staffGet("staffStatusInput").value,

        is_active:
            staffGet("staffActive").value === "true"
    };

    if (!id) {

        payload.username =
            staffGet("staffUsername").value.trim();

        payload.password =
            staffGet("staffPassword").value;

    } else if (staffGet("staffPassword").value) {

        payload.password =
            staffGet("staffPassword").value;
    }

    var errorBox = staffGet("staffError");

    if (errorBox) {
        errorBox.classList.add("hidden");
        errorBox.textContent = "";
    }

    var method = id
        ? "PATCH"
        : "POST";

    apiFetch(
        API +
        "/admin/staff" +
        (
            id
                ? "/" + encodeURIComponent(id)
                : ""
        ),
        {
            method: method,

            headers: {
                "Content-Type":
                    "application/json"
            },

            body:
                JSON.stringify(payload)
        }
    )
        .then(async function(response) {

            var data = {};

            try {
                data =
                    await response.json();
            } catch (_) {
                data = {};
            }

            if (!response.ok) {

                var message =
                    data.detail ||
                    data.message ||
                    "Failed to save staff.";

                if (
                    typeof message ===
                    "object"
                ) {
                    message =
                        JSON.stringify(message);
                }

                throw new Error(message);
            }

            return data;
        })
        .then(function() {

            closeStaffModal();

            loadStaff();

            if (
                typeof loadDashboard ===
                "function"
            ) {
                loadDashboard();
            }
        })
        .catch(function(error) {

            console.error(error);

            if (errorBox) {

                errorBox.textContent =
                    error.message;

                errorBox.classList.remove(
                    "hidden"
                );
            }
        });
}

})();
</script>



<div id="userModal" class="modal" style="display:none;">
    <div class="modal-backdrop" onclick="closeUserModal()"></div>

    <div class="modal-dialog">
        <div class="modal-header">
            <div>
                <h2 id="userModalTitle">Add User</h2>
                <p id="userModalSubtitle">Create a new platform user.</p>
            </div>
            <button type="button" class="modal-close" onclick="closeUserModal()">×</button>
        </div>

        <form id="userForm">
            <input type="hidden" id="userId">

            <div class="form-grid">
                <div class="form-group">
                    <label>Username *</label>
                    <input id="userUsername" type="text" required>
                </div>

                <div class="form-group">
                    <label>Password <span id="passwordRequired">*</span></label>
                    <input id="userPassword" type="password">
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input id="userEmail" type="email">
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input id="userPhone" type="text">
                </div>

                <div class="form-group">
                    <label>First Name</label>
                    <input id="userFirstName" type="text">
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input id="userLastName" type="text">
                </div>

                <div class="form-group">
                    <label>Language</label>
                    <input id="userLanguage" type="text" placeholder="ar">
                </div>

                <div class="form-group">
                    <label>Timezone</label>
                    <input id="userTimezone" type="text" placeholder="Asia/Aden">
                </div>

                <div class="form-group">
                    <label>Role *</label>
                    <select id="userRole" required>
                        <option value="customer">Customer</option>
                        <option value="staff">Staff</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status *</label>
                    <select id="userStatus" required>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>
            </div>

            <div id="userFormError" class="form-error" style="display:none;"></div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeUserModal()">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary" id="saveUserBtn">
                    Save User
                </button>
            </div>
        </form>
    </div>
</div>




</body>
</html>
