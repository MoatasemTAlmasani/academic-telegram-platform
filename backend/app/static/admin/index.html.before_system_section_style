    var accessRoles = [];
    var accessPermissions = [];
    var selectedAccessRoleId = null;

    async function loadAccessControl() {
        var rolesList = $("rolesList");
        var permissionsList = $("permissionsList");

        if (!rolesList || !permissionsList) {
            return;
        }

        rolesList.innerHTML =
            '<div class="loading">Loading roles...</div>';

        permissionsList.innerHTML =
            '<div class="loading">Loading permissions...</div>';

        hideAccessMessages();

        try {
            var results = await Promise.all([
                apiFetch(API + "/rbac/roles"),
                apiFetch(API + "/rbac/permissions")
            ]);

            var rolesResponse = results[0];
            var permissionsResponse = results[1];

            var rolesData = await rolesResponse.json();
            var permissionsData = await permissionsResponse.json();

            if (!rolesResponse.ok) {
                throw new Error(
                    rolesData.detail ||
                    "Unable to load roles."
                );
            }

            if (!permissionsResponse.ok) {
                throw new Error(
                    permissionsData.detail ||
                    "Unable to load permissions."
                );
            }

            accessRoles = Array.isArray(rolesData)
                ? rolesData
                : [];

            accessPermissions = Array.isArray(permissionsData)
                ? permissionsData
                : [];

            renderAccessRoles();
            renderAccessPermissions();

            if (
                selectedAccessRoleId &&
                accessRoles.some(function (role) {
                    return role.id === selectedAccessRoleId;
                })
            ) {
                selectAccessRole(selectedAccessRoleId);
            } else if (accessRoles.length) {
                selectAccessRole(accessRoles[0].id);
            } else {
                renderRolePermissions(null);
            }

        } catch (error) {
            rolesList.innerHTML =
                '<div class="empty">' +
                escapeHtml(error.message) +
                "</div>";

            permissionsList.innerHTML =
                '<div class="empty">' +
                escapeHtml(error.message) +
                "</div>";

            renderRolePermissions(null);
        }
    }


    function renderAccessRoles() {
        var container = $("rolesList");

        if (!container) {
            return;
        }

        if (!accessRoles.length) {
            container.innerHTML =
                '<div class="empty">No roles found.</div>';
            return;
        }

        container.innerHTML = accessRoles.map(
            function (role) {
                var active =
                    role.id === selectedAccessRoleId
                        ? " active"
                        : "";

                return (
                    '<button type="button" ' +
                    'class="access-item' +
                    active +
                    '" data-role-id="' +
                    escapeHtml(role.id) +
                    '">' +
                    "<strong>" +
                    escapeHtml(role.name) +
                    "</strong>" +
                    '<span class="muted">' +
                    escapeHtml(
                        role.description ||
                        "No description"
                    ) +
                    "</span>" +
                    "</button>"
                );
            }
        ).join("");

        container
            .querySelectorAll("[data-role-id]")
            .forEach(function (button) {
                button.addEventListener(
                    "click",
                    function () {
                        selectAccessRole(
                            button.getAttribute(
                                "data-role-id"
                            )
                        );
                    }
                );
            });
    }


    function renderAccessPermissions() {
        var container = $("permissionsList");

        if (!container) {
            return;
        }

        if (!accessPermissions.length) {
            container.innerHTML =
                '<div class="empty">No permissions found.</div>';
            return;
        }

        container.innerHTML = accessPermissions.map(
            function (permission) {
                return (
                    '<div class="access-item">' +
                    "<strong>" +
                    escapeHtml(permission.code) +
                    "</strong>" +
                    '<span class="muted">' +
                    escapeHtml(
                        permission.description ||
                        "No description"
                    ) +
                    "</span>" +
                    "</div>"
                );
            }
        ).join("");
    }


    function selectAccessRole(roleId) {
        selectedAccessRoleId = roleId;

        renderAccessRoles();

        var role = accessRoles.find(
            function (item) {
                return item.id === roleId;
            }
        );

        renderRolePermissions(role);
    }


    function renderRolePermissions(role) {
        var title = $("selectedRoleTitle");
        var description = $("selectedRoleDescription");
        var container = $("rolePermissionsList");
        var saveButton = $("saveRolePermissions");

        if (!container) {
            return;
        }

        if (!role) {
            if (title) {
                title.textContent = "Role Permissions";
            }

            if (description) {
                description.textContent =
                    "Select a role.";
            }

            container.innerHTML =
                '<div class="empty">' +
                "Select a role to manage permissions." +
                "</div>";

            if (saveButton) {
                saveButton.disabled = true;
            }

            return;
        }

        if (title) {
            title.textContent =
                "Permissions — " + role.name;
        }

        if (description) {
            description.textContent =
                role.description || "No description";
        }

        var assigned = new Set(
            (role.permissions || []).map(
                function (permission) {
                    return permission.code;
                }
            )
        );

        container.innerHTML = accessPermissions.map(
            function (permission) {
                var checked =
                    assigned.has(permission.code)
                        ? " checked"
                        : "";

                return (
                    '<label class="permission-check">' +
                    '<input type="checkbox" ' +
                    'class="role-permission-checkbox" ' +
                    'value="' +
                    escapeHtml(permission.code) +
                    '"' +
                    checked +
                    ">" +
                    "<span>" +
                    '<div class="permission-code">' +
                    escapeHtml(permission.code) +
                    "</div>" +
                    '<div class="permission-description">' +
                    escapeHtml(
                        permission.description ||
                        ""
                    ) +
                    "</div>" +
                    "</span>" +
                    "</label>"
                );
            }
        ).join("");

        if (saveButton) {
            saveButton.disabled = false;
        }
    }


    async function saveAccessRolePermissions() {
        if (!selectedAccessRoleId) {
            return;
        }

        var button = $("saveRolePermissions");

        var checkboxes = document.querySelectorAll(
            ".role-permission-checkbox"
        );

        var permissionCodes = [];

        checkboxes.forEach(function (checkbox) {
            if (checkbox.checked) {
                permissionCodes.push(
                    checkbox.value
                );
            }
        });

        hideAccessMessages();

        try {
            if (button) {
                button.disabled = true;
                button.textContent = "Saving...";
            }

            var response = await apiFetch(
                API +
                "/rbac/roles/" +
                selectedAccessRoleId +
                "/permissions",
                {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        permission_codes:
                            permissionCodes
                    })
                }
            );

            var data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail &&
                    typeof data.detail === "string"
                        ? data.detail
                        : "Unable to save role permissions."
                );
            }

            var updatedRole =
                data.role || null;

            if (updatedRole) {
                accessRoles = accessRoles.map(
                    function (role) {
                        return role.id === updatedRole.id
                            ? updatedRole
                            : role;
                    }
                );
            }

            renderAccessRoles();

            if (updatedRole) {
                renderRolePermissions(updatedRole);
            }

            showAccessSuccess(
                "Role permissions saved successfully."
            );

        } catch (error) {
            showAccessError(error.message);

        } finally {
            if (button) {
                button.textContent =
                    "Save Permissions";
                button.disabled = false;
            }
        }
    }


    function hideAccessMessages() {
        var error = $("accessControlError");
        var success = $("accessControlSuccess");

        if (error) {
            error.classList.add("hidden");
            error.textContent = "";
        }

        if (success) {
            success.classList.add("hidden");
            success.textContent = "";
        }
    }


    function showAccessError(message) {
        var error = $("accessControlError");

        if (error) {
            error.textContent = message;
            error.classList.remove("hidden");
        }
    }


    function showAccessSuccess(message) {
        var success = $("accessControlSuccess");

        if (success) {
            success.textContent = message;
            success.classList.remove("hidden");
        }
    }


