    async def _send_categories(
        self,
        client,
        chat_id: int,
        page: int = 0,
    ):
        async with SessionLocal() as session:
            result = await session.execute(
                select(Category)
                .where(
                    Category.is_active.is_(True),
                    Category.deleted_at.is_(None),
                )
                .order_by(Category.sort_order, Category.name)
            )
            categories = result.scalars().all()

        total = len(categories)
        total_pages = max(1, (total + CATEGORY_PAGE_SIZE - 1) // CATEGORY_PAGE_SIZE)

        page = max(0, min(page, total_pages - 1))

        start_index = page * CATEGORY_PAGE_SIZE
        page_categories = categories[
            start_index:start_index + CATEGORY_PAGE_SIZE
        ]

        keyboard = [
            [
                {
                    "text": f"📚 {category.name}",
                    "callback_data": f"category:{category.id}",
                }
            ]
            for category in page_categories
        ]

        navigation = []

        if page > 0:
            navigation.append(
                {
                    "text": "⬅️ السابق",
                    "callback_data": f"categories_page:{page - 1}",
                }
            )

        navigation.append(
            {
                "text": f"📄 {page + 1}/{total_pages}",
                "callback_data": "noop",
            }
        )

        if page < total_pages - 1:
            navigation.append(
                {
                    "text": "التالي ➡️",
                    "callback_data": f"categories_page:{page + 1}",
                }
            )

        if navigation:
            keyboard.append(navigation)

        keyboard.append(
            [
                {
                    "text": "🏠 القائمة الرئيسية",
                    "callback_data": "main_menu",
                }
            ]
        )

        text = (
            "📚 <b>الخدمات الأكاديمية</b>\n\n"
            "اختر المجال الذي تحتاج إليه:\n\n"
            f"📊 <b>{total}</b> تخصصًا متاحًا\n"
            f"📄 الصفحة <b>{page + 1}</b> من <b>{total_pages}</b>"
        )

        await self._api_call(
            client,
            "sendMessage",
            {
                "chat_id": chat_id,
                "text": text,
                "parse_mode": "HTML",
                "reply_markup": {"inline_keyboard": keyboard},
            },
        )

    async def _send_services(
        self,
        client,
        chat_id: int,
        category_id: str,
        page: int = 0,
    ):
        try:
            category_uuid = UUID(category_id)
        except ValueError:
            return

        async with SessionLocal() as session:
            category_result = await session.execute(
                select(Category).where(
                    Category.id == category_uuid,
                    Category.is_active.is_(True),
                    Category.deleted_at.is_(None),
                )
            )
            category = category_result.scalar_one_or_none()

            if category is None:
                return

            result = await session.execute(
                select(Service)
                .where(
                    Service.category_id == category_uuid,
                    Service.is_active.is_(True),
                    Service.deleted_at.is_(None),
                )
                .order_by(Service.sort_order, Service.name)
            )
            services = result.scalars().all()

        total = len(services)
        total_pages = max(1, (total + SERVICE_PAGE_SIZE - 1) // SERVICE_PAGE_SIZE)

        page = max(0, min(page, total_pages - 1))

        start_index = page * SERVICE_PAGE_SIZE
        page_services = services[
            start_index:start_index + SERVICE_PAGE_SIZE
        ]

        keyboard = [
            [
                {
                    "text": f"📌 {service.name}",
                    "callback_data": f"service:{service.id}",
                }
            ]
            for service in page_services
        ]

        navigation = []

        if page > 0:
            navigation.append(
                {
                    "text": "⬅️ السابق",
                    "callback_data": f"services_page:{category.id}:{page - 1}",
                }
            )

        navigation.append(
            {
                "text": f"📄 {page + 1}/{total_pages}",
                "callback_data": "noop",
            }
        )

        if page < total_pages - 1:
            navigation.append(
                {
                    "text": "التالي ➡️",
                    "callback_data": f"services_page:{category.id}:{page + 1}",
                }
            )

        if navigation:
            keyboard.append(navigation)

        keyboard.append(
            [
                {
                    "text": "⬅️ التصنيفات",
                    "callback_data": "services",
                },
                {
                    "text": "🏠 الرئيسية",
                    "callback_data": "main_menu",
                },
            ]
        )

        text = (
            f"📂 <b>{category.name}</b>\n\n"
            "اختر الخدمة التي تحتاج إليها:\n\n"
            f"📊 <b>{total}</b> خدمة متاحة\n"
            f"📄 الصفحة <b>{page + 1}</b> من <b>{total_pages}</b>"
        )

        await self._api_call(
            client,
            "sendMessage",
            {
                "chat_id": chat_id,
                "text": text,
                "parse_mode": "HTML",
                "reply_markup": {"inline_keyboard": keyboard},
            },
        )

    async def _send_service_details(
        self,
        client: httpx.AsyncClient,
        chat_id: int,
        service_id: str,
    ) -> None:
        try:
            service_uuid = UUID(service_id)
        except ValueError:
            return

        async with SessionLocal() as session:
            result = await session.execute(
                select(Service, Category)
                .join(Category, Service.category_id == Category.id)
                .where(
                    Service.id == service_uuid,
                    Service.is_active.is_(True),
                    Service.deleted_at.is_(None),
                    Category.is_active.is_(True),
                    Category.deleted_at.is_(None),
                )
            )
            row = result.first()

        if row is None:
            return

        service, category = row
        description = service.description or service.short_description or "لا يوجد وصف متاح لهذه الخدمة حاليًا."
        text = (
            f"📌 <b>{service.name}</b>\n\n"
            f"📂 القسم: <b>{category.name}</b>\n\n"
            f"{description}"
        )

        keyboard = {
            "inline_keyboard": [
                [{"text": "📝 تقديم طلب لهذه الخدمة", "callback_data": f"request:{service.id}"}],
                [{"text": "⬅️ الخدمات", "callback_data": "services"}],
                [{"text": "🏠 القائمة الرئيسية", "callback_data": "main_menu"}],
            ]
        }

        await self._api_call(
            client,
            "sendMessage",
            {
                "chat_id": chat_id,
                "text": text,
                "parse_mode": "HTML",
                "reply_markup": keyboard,
            },
        )

    async def _get_or_create_user(
        self,
        message: dict[str, Any],
    ) -> User | None:
        from_user = message.get("from") or {}
        telegram_user_id = from_user.get("id")

        if not isinstance(telegram_user_id, int):
            return None

        username = from_user.get("username")
        first_name = from_user.get("first_name")
        last_name = from_user.get("last_name")

        async with SessionLocal() as session:
            result = await session.execute(
                select(User).where(
                    User.telegram_user_id == telegram_user_id,
                    User.deleted_at.is_(None),
                )
            )
            user = result.scalar_one_or_none()

            if user is None:
                user = User(
                    telegram_user_id=telegram_user_id,
                    username=username,
                    first_name=first_name,
                    last_name=last_name,
                    language="ar",
                    status=UserStatus.ACTIVE,
                )
                session.add(user)
            else:
                user.username = username
                user.first_name = first_name
                user.last_name = last_name
                user.status = UserStatus.ACTIVE

            await session.commit()
            await session.refresh(user)
            return user

    async def _handle_message(
        self,
        client: httpx.AsyncClient,
        message: dict[str, Any],
    ) -> None:
        chat = message.get("chat") or {}

        if chat.get("type") != "private":
            return

        chat_id = chat.get("id")

        if not isinstance(chat_id, int):
            return

        text = str(message.get("text") or "").strip()
        from_user = message.get("from") or {}
        telegram_user_id = from_user.get("id")
        logger.info(
            "Telegram message received: user_id=%s chat_id=%s text=%r state_keys=%s",
            telegram_user_id,
            chat_id,
            text,
            list(self._conversation_state.keys()),
        )
        state = self._conversation_state.get(chat_id)

        if state is not None and text != "/start":
            if text == "/cancel":
                self._conversation_state.pop(chat_id, None)
                await self._api_call(
                    client,
                    "sendMessage",
                    {"chat_id": chat_id, "text": "❌ تم إلغاء الطلب."}
                )
                return

            stage = state.get("stage")

            if stage == "title_input" and text:
                state["title"] = text
                state["stage"] = "description"

                await self._api_call(
                    client,
                    "sendMessage",
                    {
                        "chat_id": chat_id,
                        "text": "📋 <b>الخطوة 2 من 4 — وصف الطلب</b>\\n\\nاضغط الزر لإضافة وصف الطلب.",
                        "parse_mode": "HTML",
                        "reply_markup": {
                            "inline_keyboard": [
                                [{"text": "📝 إضافة وصف الطلب", "callback_data": "request_add_description"}],
                                [{"text": "❌ إلغاء الطلب", "callback_data": "request_cancel"}],
                            ]
                        }
                    }
                )
                return

            if stage == "description_input" and text:
                state["description"] = text
                state["stage"] = "specialization"

                await self._api_call(
                    client,
                    "sendMessage",
                    {
                        "chat_id": chat_id,
                        "text": "🎓 <b>الخطوة 3 من 4 — التخصص</b>\\n\\nاضغط الزر لإضافة التخصص.",
                        "parse_mode": "HTML",
                        "reply_markup": {
                            "inline_keyboard": [
                                [{"text": "🎓 إضافة التخصص", "callback_data": "request_add_specialization"}],
                                [{"text": "❌ إلغاء الطلب", "callback_data": "request_cancel"}],
                            ]
                        }
                    }
                )
                return

            if stage == "specialization_input" and text:
                state["specialization"] = None if text == "لا يوجد" else text
                state["stage"] = "deadline"

                await self._api_call(
                    client,
                    "sendMessage",
                    {
                        "chat_id": chat_id,
                        "text": "⏰ <b>الخطوة 4 من 4 — الموعد النهائي</b>\\n\\nاضغط الزر لإضافة الموعد النهائي.",
                        "parse_mode": "HTML",
                        "reply_markup": {
                            "inline_keyboard": [
                                [{"text": "⏰ إضافة الموعد النهائي", "callback_data": "request_add_deadline"}],
                                [{"text": "❌ إلغاء الطلب", "callback_data": "request_cancel"}],
                            ]
                        }
                    }
                )
                return

            if stage == "deadline_input" and text:
                from datetime import datetime, timezone

                if text == "لا يوجد":
                    state["deadline"] = None
                else:
                    try:
                        state["deadline"] = datetime.strptime(
                            text, "%Y-%m-%d"
                        ).replace(tzinfo=timezone.utc)
                    except ValueError:
                        await self._api_call(
                            client,
                            "sendMessage",
                            {
                                "chat_id": chat_id,
                                "text": "⚠️ التاريخ غير صحيح. استخدم الصيغة: YYYY-MM-DD"
                            }
                        )
                        return

                state["stage"] = "confirm"

                specialization = state.get("specialization") or "لا يوجد"
                deadline = state.get("deadline")
                deadline_text = deadline.strftime("%Y-%m-%d") if deadline else "لا يوجد"

                summary = (
                    "📋 <b>مراجعة الطلب</b>\\n\\n"
                    f"<b>العنوان:</b> {state.get('title', '-')}\\n\\n"
                    f"<b>الوصف:</b> {state.get('description', '-')}\\n\\n"
                    f"<b>التخصص:</b> {specialization}\\n\\n"
                    f"<b>الموعد النهائي:</b> {deadline_text}\\n\\n"
                    "هل تريد إرسال الطلب؟"
                )

                await self._api_call(
                    client,
                    "sendMessage",
                    {
                        "chat_id": chat_id,
                        "text": summary,
                        "parse_mode": "HTML",
                        "reply_markup": {
                            "inline_keyboard": [
                                [{"text": "✅ تأكيد وإرسال", "callback_data": "request_confirm"}],
                                [{"text": "❌ إلغاء الطلب", "callback_data": "request_cancel"}],
                            ]
                        }
                    }
                )
                return

        if text == "/start" or text.startswith("/start "):
            await self._get_or_create_user(message)
            await self._api_call(
                client,
                "sendMessage",
                {
                    "chat_id": chat_id,
                    "text": _welcome_text(
                        chat.get("first_name"),
                    ),
                    "parse_mode": "HTML",
                    "reply_markup": _main_menu(),
                },
            )
