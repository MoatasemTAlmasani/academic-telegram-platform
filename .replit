modules = ["python-3.12", "postgresql-16", "nodejs-22"]

run = "uv run python -m backend"

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
packages = ["iproute_mptcp", "nano", "nodejs-12_x", "psmisc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python -m backend"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
