let language = "ar";
const t = key => translations[language][key] || key;

function setLanguage(next) {
  language = next;
  document.documentElement.lang = next;
  document.documentElement.dir = next === "ar" ? "rtl" : "ltr";
  document.body.dir = document.documentElement.dir;
  document.querySelectorAll("[data-i18n]").forEach(el => {
    const value = t(el.dataset.i18n);
    if (value) el.textContent = value;
  });
  document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
    el.placeholder = t(el.dataset.i18nPlaceholder);
  });
  document.getElementById("languageBtn").textContent = next === "ar" ? "English" : "العربية";
}

document.getElementById("languageBtn").addEventListener("click", () => {
  setLanguage(language === "ar" ? "en" : "ar");
});

let services = [];

function renderServices() {
  const grid = document.getElementById("serviceGrid");
  const select = document.getElementById("service");
  if (!grid || !select) return;

  grid.replaceChildren();
  select.replaceChildren();

  const placeholder = document.createElement("option");
  placeholder.value = "";
  placeholder.dataset.i18n = "chooseService";
  placeholder.textContent = t("chooseService");
  select.appendChild(placeholder);

  if (!services.length) {
    const message = document.createElement("p");
    message.className = "form-message";
    message.textContent = t("noServices");
    grid.appendChild(message);
    return;
  }

  const styles = [
    { color: "blue", icon: "⌘" },
    { color: "purple", icon: "▤" },
    { color: "cyan", icon: "✎" },
    { color: "gold", icon: "◇" }
  ];

  services.forEach((service, index) => {
    const style = styles[index % styles.length];
    const name = String(service.name || "Service");
    const description = String(
      service.short_description || service.description ||
      (service.category && service.category.name) || ""
    );

    const option = document.createElement("option");
    option.value = String(service.id);
    option.textContent = name;
    select.appendChild(option);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "service-card";
    button.dataset.service = String(service.id);

    const icon = document.createElement("span");
    icon.className = `service-icon ${style.color}`;
    icon.textContent = style.icon;

    const title = document.createElement("strong");
    title.textContent = name;

    const summary = document.createElement("small");
    summary.textContent = description;

    const arrow = document.createElement("span");
    arrow.className = "card-arrow";
    arrow.textContent = "↗";

    button.append(icon, title, summary, arrow);
    button.addEventListener("click", () => {
      select.value = String(service.id);
      document.getElementById("requestForm").scrollIntoView({
        behavior: "smooth",
        block: "center"
      });
    });

    grid.appendChild(button);
  });
}

async function loadServices() {
  const grid = document.getElementById("serviceGrid");
  if (grid) {
    grid.replaceChildren();
    const loading = document.createElement("p");
    loading.className = "form-message";
    loading.textContent = t("loadingServices");
    grid.appendChild(loading);
  }

  try {
    const response = await fetch("/api/v1/public/services", {
      headers: { "Accept": "application/json" }
    });

    if (!response.ok) {
      throw new Error(`Services request failed: ${response.status}`);
    }

    const data = await response.json();
    if (!Array.isArray(data.items)) {
      throw new Error("Unexpected services response format");
    }

    services = data.items.filter(
      item => item && item.id && item.name
    );
    renderServices();
  } catch (error) {
    console.error("Failed to load public services:", error);
    if (grid) {
      grid.replaceChildren();
      const message = document.createElement("p");
      message.className = "form-message";
      message.textContent = t("servicesLoadFailed");
      grid.appendChild(message);
    }
  }
}

document.getElementById("requestForm").addEventListener("submit", event => {
  event.preventDefault();
  const service = document.getElementById("service").value;
  const details = document.getElementById("details").value.trim();
  const message = document.getElementById("formMessage");
  if (!service) { message.textContent = t("selectServiceFirst"); return; }
  if (!details) { message.textContent = t("enterDetails"); return; }
  message.textContent = t("requestPrepared");
});

setLanguage("ar");
loadServices();
