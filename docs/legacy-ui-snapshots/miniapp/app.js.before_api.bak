    servicesTitle:"Academic Services",servicesSubtitle:"Choose a service that fits your needs",research:"Research Support",researchDesc:"Research guidance and support",
    graduation:"Graduation Projects",graduationDesc:"Project planning and guidance",editing:"Academic Editing",editingDesc:"Language, formatting and review",
    consulting:"Education Consulting",consultingDesc:"Navigate your academic path",requestTitle:"Start a Request",requestSubtitle:"Tell us what you need",
