:root{font-family:Tahoma,Arial,sans-serif;color:#172b4d;background:#f4f7fc;font-synthesis:none;--navy:#102b55;--blue:#2463eb;--muted:#77859c;--line:#e8edf5}
*{box-sizing:border-box}body{margin:0;padding:0 0 90px;background:#f4f7fc}button,input,select,textarea{font:inherit}.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;background:#fff;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:11px}.brand-mark{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:linear-gradient(145deg,#173e79,#2463eb);color:white;font-weight:800;letter-spacing:-1px}.brand strong,.brand small{display:block}.brand strong{font-size:14px;color:var(--navy)}.brand small{margin-top:4px;font-size:10px;color:var(--muted);direction:ltr;text-align:start}.language-btn{border:1px solid #dce5f5;background:#f8faff;border-radius:10px;padding:9px 12px;color:var(--navy);font-weight:700;font-size:12px}.welcome{position:relative;overflow:hidden;margin:18px 16px 26px;padding:25px 22px 23px;border-radius:24px;background:linear-gradient(120deg,#102b55,#1e4d91);color:white;min-height:205px}.eyebrow{display:inline-block;color:#bcd4ff;font-size:11px;font-weight:700}.welcome h1{position:relative;z-index:1;margin:14px 0 8px;font-size:25px}.welcome p{position:relative;z-index:1;margin:0;color:#d4e2fa;font-size:13px}.welcome-art{position:absolute;left:10px;bottom:5px;width:155px;height:145px;opacity:.95}.art-circle{position:absolute;left:12px;top:5px;width:125px;height:125px;border:1px solid #6b9ef7;border-radius:50%;background:linear-gradient(145deg,#2e66ae88,#4e91ed22)}.book{position:absolute;left:47px;top:35px;width:58px;height:67px;display:grid;place-items:center;border:1px solid #d8e8ff;border-radius:8px 15px 8px 8px;background:#fff;color:#2463eb;font-size:32px;transform:rotate(-9deg);box-shadow:0 12px 25px #071a3b66}.art-caption{position:absolute;bottom:5px;left:0;color:#bed4f8;font-size:7px;letter-spacing:1px;direction:ltr}.section{margin:0 16px 26px}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.section-heading h2{margin:0 0 6px;font-size:17px;color:var(--navy)}.section-heading p{margin:0;color:var(--muted);font-size:11px}.section-icon,.tracking-icon{font-size:25px;color:#326de0}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.service-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:9px;min-height:150px;padding:16px 14px;text-align:start;background:white;border:1px solid var(--line);border-radius:17px;color:var(--navy);box-shadow:0 4px 15px #233f6506}.service-card:active{transform:scale(.98)}.service-icon{display:grid;place-items:center;width:39px;height:39px;border-radius:12px;font-size:22px}.blue{background:#eaf1ff;color:#2865e8}.purple{background:#f1eaff;color:#8154d8}.cyan{background:#e3f9fb;color:#1498aa}.gold{background:#fff4dc;color:#c78a16}.service-card strong{font-size:12px}.service-card small{font-size:10px;color:var(--muted);line-height:1.5}.card-arrow{position:absolute;top:15px;inset-inline-end:14px;color:#9aabc3;font-size:14px}.request-panel{padding:19px 16px;background:#fff;border:1px solid var(--line);border-radius:20px}.request-symbol{display:grid;place-items:center;width:35px;height:35px;background:#eaf1ff;color:var(--blue);border-radius:11px;font-size:24px}form{display:flex;flex-direction:column;gap:9px}form label{font-size:12px;font-weight:700;color:#344867;margin-top:5px}select,textarea{width:100%;border:1px solid #dfe7f2;border-radius:11px;padding:12px;background:#fbfcff;color:#263b59;outline:none;font-size:12px}textarea{resize:vertical;line-height:1.7}select:focus,textarea:focus{border-color:#6190f2}.primary-btn{display:flex;align-items:center;justify-content:space-between;margin-top:6px;padding:14px 16px;border:0;border-radius:12px;background:linear-gradient(100deg,#2463eb,#1747b7);color:white;font-weight:700;font-size:13px;box-shadow:0 7px 16px #2463eb26}.form-message{margin:0;color:#526580;font-size:11px;line-height:1.6}.empty-state{display:flex;flex-direction:column;align-items:center;text-align:center;padding:24px 18px;background:#fff;border:1px dashed #dce5f2;border-radius:17px}.empty-icon{display:grid;place-items:center;width:48px;height:48px;margin-bottom:12px;border-radius:15px;background:#edf3ff;color:#4778d8;font-size:25px}.empty-state strong{font-size:12px;color:#344867}.empty-state p{max-width:240px;margin:8px 0 0;color:var(--muted);font-size:11px;line-height:1.8}.bottom-nav{position:fixed;z-index:5;bottom:0;left:0;right:0;display:flex;justify-content:space-around;padding:10px 8px calc(10px + env(safe-area-inset-bottom));background:#ffffffed;border-top:1px solid var(--line);backdrop-filter:blur(12px)}.nav-item{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:55px;color:#8996aa;text-decoration:none}.nav-item span{font-size:21px}.nav-item small{font-size:10px}.nav-item.active{color:var(--blue);font-weight:700}body[dir=ltr] .welcome-art{left:auto;right:10px}body[dir=ltr] .art-caption{text-align:left}body[dir=ltr] .service-card{text-align:left}@media(min-width:650px){body{max-width:560px;margin:0 auto;border-left:1px solid var(--line);border-right:1px solid var(--line)}.topbar{padding-inline:24px}.welcome{margin-inline:22px}.section{margin-inline:22px}.service-grid{gap:14px}}
